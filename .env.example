# ==============================================================================
# Tooly.tn - Environment Variables Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development

# Web App (Next.js)
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# API Service (NestJS)
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# For local development with Docker or Windows PostgreSQL:
DATABASE_URL="postgresql://tooly:tooly_dev_secret@localhost:5432/tooly_db?schema=public"

# Authentication (JWT)
JWT_SECRET="tooly_super_secret_jwt_key_min_32_chars_dev_only"
JWT_EXPIRES_IN="7d"

# Payment Process Mode (Business Decision: Outside platform for initial launch)
# Options: offline_transfer, manual, payment_gateway
PAYMENT_FULFILLMENT_MODE=offline_transfer

# AI Assistant (Optional live LLM integration for Tooly Bot)
# If provided, Tooly Bot leverages Google Gemini or OpenAI for generative conversational AI
GEMINI_API_KEY=""
OPENAI_API_KEY=""
