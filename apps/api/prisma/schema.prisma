// Tooly.tn Prisma Schema
// Canonical persistence layer owned by apps/api

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLMENT_PENDING
  FULFILLED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum DeliveryMethod {
  MANUAL_SUPPORT
  OFFLINE_TRANSFER
  VOUCHER_CODE
  TEAM_INVITE
  CREDENTIALS_PROVISION
}

enum CatalogOptionKind {
  DELIVERY_METHOD
  DURATION
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
  REPLIED
}

model CatalogOption {
  id        String            @id @default(uuid())
  kind      CatalogOptionKind
  code      String
  labelAr   String
  labelFr   String
  labelEn   String
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([kind, code])
  @@index([kind, sortOrder])
  @@map("catalog_options")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  name         String?
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@map("categories")
}

model Product {
  id             String          @id @default(uuid())
  slug           String          @unique
  categoryId     String
  provider       String          // e.g. "Anthropic", "OpenAI", "Canva"
  deliveryMethod String          @default("OFFLINE_TRANSFER")
  isPublished    Boolean         @default(true)
  isDemo         Boolean         @default(true) // Explicit demo indicator
  sortOrder      Int             @default(0)
  iconUrl        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants       PlanVariant[]

  @@index([categoryId, isPublished])
  @@map("products")
}

model PlanVariant {
  id           String      @id @default(uuid())
  productId    String
  slug         String      @unique
  duration     String      // e.g. "1_month", "3_months", "1_year"
  price        Decimal     @db.Decimal(10, 3) // TND requires 3 decimal places (millimes)
  currency     String      @default("TND")
  isAvailable  Boolean     @default(true)
  isDemo       Boolean     @default(true)
  features     Json?       // Feature list
  restrictions Json?       // Terms and fair-use restrictions
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([productId, isAvailable])
  @@map("plan_variants")
}

model LocalizedContent {
  id         String   @id @default(uuid())
  entityType String   // "category", "product", "plan_variant"
  entityId   String
  locale     String   // "ar", "fr", "en"
  name       String
  tagline    String?
  description String?
  features   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([locale, entityType])
  @@map("localized_contents")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique // e.g. "TLY-2026-1001"
  userId       String
  status       OrderStatus @default(DRAFT)
  currency     String      @default("TND")
  totalAmount  Decimal     @db.Decimal(10, 3)
  customerNotes String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  fulfillment  Fulfillment?

  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id            String      @id @default(uuid())
  orderId       String
  planVariantId String
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 3) // Price snapshot at purchase
  productTitle  String      // Snapshot of product name
  planDuration  String      // Snapshot of duration

  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planVariant   PlanVariant @relation(fields: [planVariantId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Fulfillment {
  id           String         @id @default(uuid())
  orderId      String         @unique
  status       String         @default("pending")
  method       DeliveryMethod @default(OFFLINE_TRANSFER)
  instructions String?
  fulfilledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("fulfillments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@map("audit_logs")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(UNREAD)
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  locale    String?  @default("ar")
  visitorId String?
  ipHash    String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorId])
  @@map("page_views")
}
