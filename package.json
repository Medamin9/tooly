{
  "name": "tooly-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tooly.tn digital-subscription marketplace monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@tooly/web",
    "dev:api": "npm run dev --workspace=@tooly/api",
    "build:packages": "npm run build --workspace=@tooly/contracts",
    "build": "npm run build:packages && npm run build --workspace=@tooly/api && npm run build --workspace=@tooly/web",
    "build:web": "npm run build:packages && npm run build --workspace=@tooly/web",
    "build:api": "npm run build:packages && npm run build --workspace=@tooly/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "update:vps": "bash scripts/update-vps.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
